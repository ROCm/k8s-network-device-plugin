# Local build container for Go and Helm work: build, test, lint, helm, mocks.
# Not used to build the product image; `make image` runs on the host.

ARG GOLANG_VERSION=1.25.8
ARG BUILD_BASE_IMG=golang:${GOLANG_VERSION}
FROM ${BUILD_BASE_IMG}

# Keep minimal; this layer is rebuilt whenever the base image changes.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        make \
    && rm -rf /var/lib/apt/lists/*

# Helm (sha256 pinned)
ARG HELM_VERSION=v3.21.4
ARG HELM_SHA256=61f88ab166748cb19604d7884cb100ae9ccb13804ddeb98e08af167eacbb6a14
RUN curl --proto '=https' --tlsv1.2 -fsSL -o helm.tar.gz \
        "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" && \
    echo "${HELM_SHA256}  helm.tar.gz" | sha256sum -c - && \
    tar -xzf helm.tar.gz --strip-components=1 -C /usr/local/bin linux-amd64/helm && \
    rm helm.tar.gz

# Go tooling. Versions must match the ones pinned in the Makefile.
ARG GOLANGCI_LINT_VERSION=v1.63.4
ARG HELM_DOCS_VERSION=v1.12.0
ARG MOCKERY_VERSION=v2.53.6
# Clean the caches in the same layer; they are large and unused at runtime.
RUN go install "github.com/golangci/golangci-lint/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" && \
    go install "github.com/norwoodj/helm-docs/cmd/helm-docs@${HELM_DOCS_VERSION}" && \
    go install "github.com/vektra/mockery/v2@${MOCKERY_VERSION}" && \
    go clean -cache -modcache -testcache

# Targets run as the invoking user, so the tools must be readable by any uid.
RUN chmod -R a+rx /go/bin

# Override the Makefile's tool variables so it uses these copies instead of
# installing its own into the mounted workspace.
ENV GOLANGCI_LINT=/go/bin/golangci-lint \
    HELMDOCS=/go/bin/helm-docs \
    MOCKERY=/go/bin/mockery

# The workspace is bind-mounted and owned by the invoking user, not the image.
RUN git config --system --add safe.directory /k8s-network-device-plugin

WORKDIR /k8s-network-device-plugin
